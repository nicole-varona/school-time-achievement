% ---- 2.2 Causal evidence, Latin America, and "for whom" ---------------------
@techreport{orkin2013,
  author      = {Orkin, Kate},
  title       = {The Effect of Lengthening the School Day on Children's Achievement in Ethiopia},
  institution = {Young Lives, University of Oxford},
  type        = {Working Paper},
  number      = {119},
  year        = {2013},
  isbn        = {978-1-909403-32-1},
  note        = {Ethiopia's 2005 federal directive to
                 abolish shift teaching and move from a four- to a six-hour day, rolled
                 out by districts at different times; DiD with school fixed effects on
                 Young Lives panel data, children aged 8. Effects are ODDS RATIOS on
                 ordinal literacy/numeracy measures, NOT standard deviations: 2.17x more
                 likely to be numerate, 3.51x to write; reading positive but not
                 significant. Effects larger for better-off children (not stunted,
                 wealthier households, urban schools) but larger for girls than boys.
                 Reports that moving from shift to full-day schooling raises the cost of
                 primary education by 25--60\%, and compiles the prior literature at
                 0.009--0.12 SD.}
}
