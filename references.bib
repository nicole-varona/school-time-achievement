@techreport{alvarez2019,
  author      = {\'Alvarez Ojeda, Andrea and Bayona-Rodr\'iguez, Hernando},
  title       = {{Impacto de los programas de ampliaci\'on de la jornada escolar sobre el desempe\~no en matem\'aticas y lenguaje: un metan\'alisis para 8 pa\'ises}},
  institution = {Universidad de los Andes, Facultad de Econom\'ia, CEDE},
  type        = {Documentos CEDE},
  number      = {2019-02},
  year        = {2019},
  url         = {https://ssrn.com/abstract=3334088},
  note        = {Random-effects meta-analysis of 14
                 studies published 2007--2017 covering 8 countries: Brazil (Rio de
                 Janeiro), Chile, Colombia, Italy, Mexico, the Netherlands, Uruguay
                 and the United States -- Argentina is NOT among them. Pooled:
                 primary mathematics 0.04 SD (sig.\ at 10\%, p=0.058, I2=85.4\%),
                 primary language 0.04 SD (sig.\ at 5\%, I2=73.6\%), secondary 0.10
                 and 0.08 SD (both at 1\%). Largest primary effects: Uruguay ETC
                 +0.29 SD maths / +0.21 SD language; most negative: Mais Educa\c{c}\~ao
                 (Brazil) -0.22 SD maths / -0.14 SD language.}
}
